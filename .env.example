# Обов'язково для розмови (слухає безплатне розпізнавання Google у браузері)
OPENAI_API_KEY=sk-...

# Голос (TTS): достатньо одного з двох. Провайдер без ключа не з'являється в списку на сторінці.
RESPEECHER_API_KEY=
SONIOX_API_KEY=

# LLM («думає»). Будь-яка текстова модель OpenAI зі стрімінгом.
OPENAI_MODEL=gpt-4.1-mini

# «Слух» Realtime (за замовчуванням на сторінці): модель сама слухає мікрофон і відповідає ТЕКСТОМ, який озвучує
# Respeecher/Soniox. Слухання платне: кожна секунда звуку, навіть тиша.
# REALTIME_MODEL=gpt-realtime-2.1
# REALTIME_TRANSCRIBE_MODEL=gpt-4o-transcribe   # текст вашої фрази для історії
# REALTIME_SILENCE_MS=700                       # скільки тиші закінчує фразу
# REALTIME_VAD_THRESHOLD=0.5
# TTS_ONE_GENERATION=1                          # 1: одна генерація голосу на всю відповідь; 0: окрема на кожне речення
# REALTIME_TURN=server                          # server (тиша REALTIME_SILENCE_MS) | semantic (модель сама судить, що фраза скінчилась)
# REALTIME_EAGERNESS=high                       # для semantic: low | medium | high | auto; high = відповідає найшвидше

# База (як в Eva): Postgres на Neon. Порожньо — SQLite-файл data/agent.db (на Render кожен деплой його стирає).
# Тут лежать «Знання агента». Можна вставити той самий DATABASE_URL, що в Eva: таблиця agent_about, таблиць Eva не чіпає.
# DATABASE_URL=postgresql://…?sslmode=require
# AGENT_SQLITE=data/agent.db

# Часовий пояс для дати й часу доби в промпті (IANA).
# TIMEZONE=Europe/Kyiv

# Ціни для лічильника витрат на сторінці, USD. Орієнтовні: модель — за 1M токенів (як для gpt-4.1-mini, міняйте разом з
# OPENAI_MODEL), Respeecher — $2 за 60 тис. символів (з сторонніх джерел), ціна голосу Soniox невідома, тому 0.
# PRICE_LLM_IN_PER_M=0.40
# PRICE_LLM_OUT_PER_M=1.60
# Те саме для Realtime (оцінка: звіртесь з актуальним прайсом REALTIME_MODEL): текст на вході, текст на виході, звук на вході.
# PRICE_RT_TEXT_IN_PER_M=4.0
# PRICE_RT_TEXT_OUT_PER_M=16.0
# PRICE_RT_AUDIO_IN_PER_M=32.0
# PRICE_RESPEECHER_PER_1K_CHARS=0.033
# PRICE_SONIOX_PER_1K_CHARS=0
# PRICE_SEARCH=0.008

# Пошук в інтернеті (Tavily, як в Eva). Без ключа агент чесно каже, що не знає свіжого.
WEB_SEARCH_API_KEY=
# WEB_SEARCH_TIMEOUT_S=9

# --- Respeecher TTS ---
# public/tts/ua-rt — українська, public/tts/en-rt — англійська
# RESPEECHER_MODEL=public/tts/ua-rt
# Список голосів бекенд бере з API провайдера. Ці — запасні, якщо API недоступне (перший — за замовчуванням)
# RESPEECHER_VOICES=olesia-conversation
# RESPEECHER_SAMPLE_RATE=24000

# --- Soniox TTS ---
# SONIOX_TTS_MODEL=tts-rt-v2
# SONIOX_TTS_LANGUAGE=uk
# SONIOX_VOICES=Taras
# SONIOX_TTS_SAMPLE_RATE=24000

# Free-план Render засинає після ~15 хв без запитів: бекенд пінгує сам себе (адреса з RENDER_EXTERNAL_URL).
# Інтервал у хвилинах, 0 — вимкнути.
# KEEP_AWAKE_MINUTES=10

# Дозволені origin-и, якщо фронтенд окремо від бекенду (через кому)
# FRONTEND_ORIGINS=http://localhost:5173
