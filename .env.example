# OpenAI API key — обов'язково.
OPENAI_API_KEY=sk-...

# GPT-Live
OPENAI_LIVE_MODEL=gpt-live-1
# Модель «бекенду», що виконує інструменти (голос, ім'я, мова…).
OPENAI_LIVE_BACKEND_MODEL=gpt-6-luna
OPENAI_LIVE_VOICE=willow
OPENAI_LIVE_AUDIO_RATE=24000
# Власні голоси GPT-Live (platform.openai.com → Audio → Voices, тип Prompt-generated; лише gpt-live-1).
# Голос прив'язаний до проєкту OpenAI: на ключі іншого проєкту буде 404. Порожньо → працює пресет персонажа
# (Тарас — meridian, Степан — cedar, Кішка — bossa).
# OPENAI_VOICE_TARAS=voice_...
# OPENAI_VOICE_TOLIK=voice_...
# OPENAI_VOICE_KISHKA=voice_...

# Часовий пояс для «сьогодні» й часу доби в промпті (IANA).
TIMEZONE=Europe/Kyiv

# Desktop: two-stage local barge-in (duck → confirm) + busy cues
# VOICE_LOCAL_BARGE_IN=true
# VOICE_BARGE_IN_ONSET_FRAMES=3
# VOICE_BARGE_IN_CONFIRM_MS=1200
# VOICE_BARGE_IN_MIN_SPEECH_MS=600
# VOICE_BARGE_IN_REJECT_SILENCE_MS=300
# VOICE_BARGE_IN_ECHO_MARGIN=2.5
# VOICE_BARGE_IN_DUCK_VOLUME=0.5
# VOICE_BARGE_IN_USE_ENERGY_GATE=true
# VOICE_BARGE_IN_ENERGY_MARGIN=2.2
# VOICE_BARGE_IN_ENERGY_MARGIN_PLAYING=3.0
# VOICE_BARGE_IN_COOLDOWN_MS=500
# VOICE_BARGE_IN_SUPPRESS_MS=400
# VOICE_BUSY_CUES_ENABLED=true
# VOICE_BUSY_CUE_DELAY_MS=900
# VOICE_BUSY_CUE_SECOND_DELAY_MS=3000
# VOICE_BUSY_CUE_MAX_PER_TURN=2

# Pause («Дякую, Єва») = nobody talks to her: keep what is said nearby and remind later.
# false = she remembers nothing from her pauses (the web page has its own on/off button).
# BACKGROUND_LISTENING=true

# Desktop, like the web page: nobody spoke this long → pause (0 = never); a pause keeps the session
# open (muted) this long, so «Єва, скажи» answers at once; later a new session starts with the history.
# IDLE_PAUSE_SECONDS=90
# PAUSE_CLOSE_SECONDS=30
# Desktop delivery prompt: v4 (default, v3 + full, concrete answers) / v3 (v2 + behaves like a person) / v2 / v1.
# LIVE_PROMPT_VARIANT=v4

# Вебпошук (tool `web_search`, Tavily). Без ключа Єва каже, що пошук недоступний — розмова не падає.
WEB_SEARCH_API_KEY=
# WEB_SEARCH_TIMEOUT_S=9
# WEB_SEARCH_MAX_CALLS_PER_TURN=2

# Web backend (server/, Render)
# PUBLIC_BACKEND_URL=http://localhost:8000
# FRONTEND_ORIGINS=http://localhost:5173
